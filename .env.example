# ─────────────────────────────────────────────────────────────────────────────
# Mogsthetics — environment variables
# Copy to .env.local for development. Never commit real secrets.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser; nothing else is.
# ─────────────────────────────────────────────────────────────────────────────

# Backend: "supabase" (production) or "local" (embedded Postgres + local auth, dev/test only;
# refused when VERCEL_ENV=production). Defaults to supabase when NEXT_PUBLIC_SUPABASE_URL is set.
NUTRILENS_BACKEND=local
LOCAL_DATA_DIR=.data/local
# 32+ random characters. Signs local-mode session cookies and local image URLs.
SESSION_SECRET=

# Public URL of the deployment (used in auth email links)
APP_URL=http://localhost:3000

# ── Supabase (production) ────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key — safe for the browser; data is protected by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (service-role) key — SERVER ONLY. Used for image storage and account deletion.
SUPABASE_SECRET_KEY=
# Postgres connection string. On Vercel use the Supavisor *transaction* pooler (port 6543).
# The server switches to the `authenticated` role per request so RLS applies.
DATABASE_URL=
SUPABASE_STORAGE_BUCKET=meal-images

# ── AI ───────────────────────────────────────────────────────────────────────
# anthropic | mock | none. Defaults to anthropic when ANTHROPIC_API_KEY is set, otherwise mock
# (mock is disabled on production deployments unless ALLOW_MOCK_AI=true).
AI_PROVIDER=
ANTHROPIC_API_KEY=
AI_VISION_MODEL=claude-opus-5-5
AI_COACH_MODEL=claude-opus-5-5
AI_REQUEST_TIMEOUT_MS=120000
ALLOW_MOCK_AI=

# ── Nutrition data ───────────────────────────────────────────────────────────
# Free key from https://fdc.nal.usda.gov/api-key-signup (optional: bundled USDA foods work offline)
USDA_FDC_API_KEY=
# Open Food Facts asks apps to identify themselves: "AppName/Version (contact email)"
OFF_USER_AGENT=Mogsthetics/0.1 (you@example.com)
ENABLE_EXTERNAL_FOOD_APIS=true

# ── Operations ───────────────────────────────────────────────────────────────
# Bearer token Vercel Cron sends to /api/cron/cleanup (image retention, cache purge)
CRON_SECRET=
QUOTA_ANALYSES_PER_DAY=40
QUOTA_COACH_MESSAGES_PER_DAY=80
QUOTA_SUGGESTIONS_PER_DAY=40
